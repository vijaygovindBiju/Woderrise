import { Theme, PackageCardData } from "./theme.slint";
import { PackageCard } from "./package_card.slint";

component CategoryChip inherits Rectangle {
    in property <string> label: "";
    in property <bool> is-active: false;

    callback clicked();

    height: 26px;
    border-radius: Theme.radius-pill;
    background: root.is-active ? Theme.accent-blue : (touch.has-hover ? Theme.bg-surface1 : Theme.bg-surface0);
    border-width: 1px;
    border-color: root.is-active ? Theme.accent-blue : Theme.bg-surface2;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;

        Text {
            text: root.label;
            font-size: Theme.font-size-xs;
            font-weight: root.is-active ? 700 : 500;
            color: root.is-active ? Theme.text-dark : Theme.text-main;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PackageList inherits Rectangle {
    in property <[PackageCardData]> packages: [];
    in-out property <int> selected-index: 0;
    in-out property <string> search-query: "";
    in-out property <string> selected-category: "All";
    in property <int> total-count: 1;

    callback search-modified(string);
    callback category-selected(string);
    callback item-clicked(int);

    width: 440px;
    background: Theme.bg-base;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // View Header
        HorizontalLayout {
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: "Package Catalog";
                font-size: Theme.font-size-lg;
                font-weight: 700;
                color: Theme.text-main;
            }

            Text {
                text: root.packages.length + " of " + root.total-count + " verified";
                font-size: Theme.font-size-xs;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }

        // Search Input Bar
        Rectangle {
            height: 40px;
            background: Theme.bg-surface0;
            border-radius: Theme.radius-sm;
            border-width: input-touch.has-hover ? 1.5px : 1px;
            border-color: input-touch.has-hover ? Theme.accent-blue : Theme.bg-surface1;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: "🔍";
                    font-size: 13px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                // Input field
                Rectangle {
                    horizontal-stretch: 1;

                    if root.search-query == "" : Text {
                        text: "Search packages, rices, themes...";
                        font-size: Theme.font-size-body;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }

                    search-input := TextInput {
                        text <=> root.search-query;
                        font-size: Theme.font-size-body;
                        color: Theme.text-main;
                        single-line: true;
                        vertical-alignment: center;
                        edited => {
                            root.search-modified(self.text);
                        }
                    }
                }

                if root.search-query != "" : Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.bg-surface2;

                    Text {
                        text: "✕";
                        font-size: 10px;
                        color: Theme.text-main;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.search-query = "";
                            root.search-modified("");
                        }
                    }
                }
            }

            input-touch := TouchArea {}
        }

        // Category Filter Chips
        HorizontalLayout {
            spacing: 6px;

            CategoryChip {
                label: "All";
                is-active: root.selected-category == "All";
                clicked => {
                    root.selected-category = "All";
                    root.category-selected("All");
                }
            }

            CategoryChip {
                label: "Themes & Bars";
                is-active: root.selected-category == "bar_themes_modules";
                clicked => {
                    root.selected-category = "bar_themes_modules";
                    root.category-selected("bar_themes_modules");
                }
            }

            CategoryChip {
                label: "Window Managers";
                is-active: root.selected-category == "window_managers";
                clicked => {
                    root.selected-category = "window_managers";
                    root.category-selected("window_managers");
                }
            }

            CategoryChip {
                label: "Shells";
                is-active: root.selected-category == "shells";
                clicked => {
                    root.selected-category = "shells";
                    root.category-selected("shells");
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.bg-surface0;
        }

        // Scrollable Package Cards List
        Flickable {
            vertical-stretch: 1;
            content-height: card-layout.min-height;

            card-layout := VerticalLayout {
                spacing: 10px;

                if root.packages.length == 0 : Rectangle {
                    height: 140px;
                    border-radius: Theme.radius-md;
                    background: Theme.bg-surface0.with-alpha(0.3);
                    border-width: 1px;
                    border-color: Theme.bg-surface0;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "No packages found";
                            font-size: Theme.font-size-md;
                            font-weight: 600;
                            color: Theme.text-sub;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Try clearing the search query or changing category";
                            font-size: Theme.font-size-xs;
                            color: Theme.text-dim;
                            horizontal-alignment: center;
                        }
                    }
                }

                for pkg[idx] in root.packages : PackageCard {
                    data: pkg;
                    is-selected: root.selected-index == idx;
                    clicked => {
                        root.selected-index = idx;
                        root.item-clicked(idx);
                    }
                }
            }
        }
    }
}
