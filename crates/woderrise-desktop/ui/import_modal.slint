import { Theme } from "./theme.slint";

export component ImportModal inherits Rectangle {
    in-out property <string> url-input: "";
    in property <string> error-message: "";
    in property <bool> is-loading: false;

    callback close-clicked();
    callback submit-clicked(string);

    background: #11111be0;

    Rectangle {
        width: 580px;
        height: root.error-message != "" ? 330px : 290px;
        background: Theme.bg-mantle;
        border-radius: Theme.radius-lg;
        border-width: 1.5px;
        border-color: Theme.accent-mauve;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Text {
                    horizontal-stretch: 1;
                    text: "Import Desktop Rice from GitHub";
                    font-size: Theme.font-size-lg;
                    font-weight: 800;
                    color: Theme.text-main;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: close-touch.has-hover ? Theme.bg-surface1 : Theme.bg-surface0;

                    Text {
                        text: "✕";
                        font-size: 13px;
                        color: close-touch.has-hover ? Theme.accent-red : Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !root.is-loading {
                                root.close-clicked();
                            }
                        }
                    }
                }
            }

            Text {
                text: "Enter a public GitHub repository URL containing Hyprland dotfiles (hyprland.conf, hyprlock.conf, hypridle.conf, Waybar styles). Woderrise will clone, detect dotfiles, compute cryptographic hashes, and synthesize an installable package.";
                font-size: Theme.font-size-xs;
                color: Theme.text-sub;
                wrap: word-wrap;
            }

            Rectangle {
                height: 44px;
                border-radius: Theme.radius-sm;
                background: Theme.bg-surface0;
                border-width: 1px;
                border-color: root.error-message != "" ? Theme.accent-red : (url-input-field.has-focus ? Theme.accent-blue : Theme.bg-surface1);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "🔗";
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;

                        if root.url-input == "" : Text {
                            text: "https://github.com/owner/repository";
                            font-size: Theme.font-size-body;
                            font-family: "monospace";
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }

                        url-input-field := TextInput {
                            text <=> root.url-input;
                            font-size: Theme.font-size-body;
                            font-family: "monospace";
                            color: Theme.text-main;
                            single-line: true;
                            vertical-alignment: center;
                            enabled: !root.is-loading;
                            accepted => {
                                if !root.is-loading && root.url-input != "" {
                                    root.submit-clicked(root.url-input);
                                }
                            }
                        }
                    }

                    if root.url-input != "" && !root.is-loading : Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Theme.bg-surface2;

                        Text {
                            text: "✕";
                            font-size: 10px;
                            color: Theme.text-main;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.url-input = ""; }
                        }
                    }
                }
            }

            if root.error-message != "" : Rectangle {
                height: 32px;
                border-radius: Theme.radius-xs;
                background: Theme.accent-red.with-alpha(0.15);
                border-width: 1px;
                border-color: Theme.accent-red.with-alpha(0.3);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "⚠";
                        font-size: 12px;
                        color: Theme.accent-red;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.error-message;
                        font-size: Theme.font-size-xs;
                        color: Theme.accent-red;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                Rectangle {
                    width: 100px;
                    height: 38px;
                    border-radius: Theme.radius-sm;
                    background: cancel-touch.has-hover ? Theme.bg-surface1 : Theme.bg-surface0;
                    border-width: 1px;
                    border-color: Theme.bg-surface2;

                    Text {
                        text: "Cancel";
                        font-size: Theme.font-size-body;
                        font-weight: 600;
                        color: Theme.text-sub;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !root.is-loading {
                                root.close-clicked();
                            }
                        }
                    }
                }

                Rectangle {
                    width: 175px;
                    height: 38px;
                    border-radius: Theme.radius-sm;
                    background: (root.is-loading || root.url-input == "") ? Theme.bg-surface1 :
                                (submit-touch.has-hover ? Theme.accent-mauve.brighter(0.15) : Theme.accent-mauve);
                    opacity: (root.is-loading || root.url-input == "") ? 0.6 : 1.0;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.is-loading ? "Fetching..." : "Import & Synthesize";
                            font-size: Theme.font-size-body;
                            font-weight: 700;
                            color: (root.is-loading || root.url-input == "") ? Theme.text-dim : Theme.text-dark;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    submit-touch := TouchArea {
                        mouse-cursor: (root.is-loading || root.url-input == "") ? default : pointer;
                        clicked => {
                            if !root.is-loading && root.url-input != "" {
                                root.submit-clicked(root.url-input);
                            }
                        }
                    }
                }
            }
        }
    }
}
